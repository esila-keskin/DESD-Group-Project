<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Web Modeler" exporterVersion="6a0669f" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.10.0">
  <bpmn:collaboration id="Collaboration_10y653v">
    <bpmn:participant id="Participant_1rwshv2" name="BRFN Marketplace: Process payment and commission" processRef="process-payment-commission" />
    <bpmn:participant id="Participant_0cdkve2" name="Payment Provider (simulated)" />
    <bpmn:participant id="Participant_11v13uw" name="Producers" />
    <bpmn:messageFlow id="Flow_151iua4" name="Payment request" sourceRef="Activity_0xalhrl" targetRef="Participant_0cdkve2" />
    <bpmn:messageFlow id="Flow_1bkgcjv" name="Payment result" sourceRef="Participant_0cdkve2" targetRef="Activity_0xalhrl" />
    <bpmn:messageFlow id="Flow_1ikkfde" name="New order notification" sourceRef="Activity_1b979ic" targetRef="Participant_11v13uw" />
    <bpmn:textAnnotation id="TextAnnotation_04ixtdw">
      <bpmn:text>Max 3 attempts in total, declines and service failures counted together (Q8).</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_118cxdh" associationDirection="None" sourceRef="Activity_0xalhrl" targetRef="TextAnnotation_04ixtdw" />
    <bpmn:textAnnotation id="TextAnnotation_1y9neqt">
      <bpmn:text>5% per producer, rounded half up to whole pence. 640p gives 32p, 450p gives 23p.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1kmnmvf" associationDirection="None" sourceRef="Flow_0qktwlm" targetRef="TextAnnotation_1y9neqt" />
  </bpmn:collaboration>
  <bpmn:process id="process-payment-commission" name="Process payment and commission" isExecutable="true">
    <bpmn:laneSet id="LaneSet_0l42yh9">
      <bpmn:lane id="Lane_1up2k2s" name="Customer">
        <bpmn:flowNodeRef>Activity_1muf6gd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_1b34ye9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_0msy8h1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_0aroag0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_1oqi2gn</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_0v5u13m" name="Marketplace platform">
        <bpmn:flowNodeRef>Activity_0xalhrl</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_1gcgci5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_0safgti</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_0nhigz6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_0fve4zz</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_1yg77ze</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_0aqerhl</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_1wworen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_1di40os</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_1b979ic</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_0n0zfbw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_05smdbd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_1rq6wws</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_05limqu</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:userTask id="Activity_1muf6gd" name="Enter payment details">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="f2-enter-payment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1yqvjqy</bpmn:incoming>
      <bpmn:outgoing>Flow_01228dd</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Activity_0xalhrl" name="Take payment">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="take-payment" />
        <zeebe:ioMapping>
          <zeebe:output source="=paymentStatus" target="paymentStatus" />
          <zeebe:output source="=null" target="testCardNumber" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_16onj4i</bpmn:incoming>
      <bpmn:outgoing>Flow_0bpiazk</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_16onj4i" sourceRef="Activity_05limqu" targetRef="Activity_0xalhrl" />
    <bpmn:sequenceFlow id="Flow_1umldow" sourceRef="Event_05smdbd" targetRef="Gateway_1gcgci5" />
    <bpmn:exclusiveGateway id="Gateway_1gcgci5" name="Unavailable: attempts left?" default="Flow_1brll1b">
      <bpmn:incoming>Flow_1umldow</bpmn:incoming>
      <bpmn:outgoing>Flow_0yo1d6m</bpmn:outgoing>
      <bpmn:outgoing>Flow_1brll1b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_0yo1d6m" name="Yes" sourceRef="Gateway_1gcgci5" targetRef="Event_0safgti">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=paymentAttempts &lt; 3</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:intermediateCatchEvent id="Event_0safgti" name="Wait 10 seconds">
      <bpmn:incoming>Flow_0yo1d6m</bpmn:incoming>
      <bpmn:outgoing>Flow_0h0s9zh</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_1kqlta9">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">=if retryDelay = null then duration("PT10S") else duration(retryDelay)</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="Flow_1brll1b" name="No" sourceRef="Gateway_1gcgci5" targetRef="Event_0nhigz6" />
    <bpmn:endEvent id="Event_0nhigz6" name="Not paid: service unavailable">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="=&#34;UNPAID&#34;" target="orderStatus" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1brll1b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_0fve4zz" name="Payment result?" default="Flow_02nkly2">
      <bpmn:incoming>Flow_0bpiazk</bpmn:incoming>
      <bpmn:outgoing>Flow_02nkly2</bpmn:outgoing>
      <bpmn:outgoing>Flow_0b86b76</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_0bpiazk" sourceRef="Activity_0xalhrl" targetRef="Gateway_0fve4zz" />
    <bpmn:sequenceFlow id="Flow_02nkly2" name="Declined" sourceRef="Gateway_0fve4zz" targetRef="Gateway_1yg77ze" />
    <bpmn:exclusiveGateway id="Gateway_1yg77ze" name="Declined: attempts left?" default="Flow_0aax9nr">
      <bpmn:incoming>Flow_02nkly2</bpmn:incoming>
      <bpmn:outgoing>Flow_1rvzzxz</bpmn:outgoing>
      <bpmn:outgoing>Flow_0aax9nr</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_1rvzzxz" name="Yes" sourceRef="Gateway_1yg77ze" targetRef="Activity_1b34ye9">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=paymentAttempts &lt; 3</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:userTask id="Activity_1b34ye9" name="Retry payment">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="f2-retry-payment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1rvzzxz</bpmn:incoming>
      <bpmn:outgoing>Flow_1h3pian</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="Event_0aqerhl" name="Not paid: declined 3 times">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="=&#34;UNPAID&#34;" target="orderStatus" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0aax9nr</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0aax9nr" name="No" sourceRef="Gateway_1yg77ze" targetRef="Event_0aqerhl" />
    <bpmn:exclusiveGateway id="Gateway_0msy8h1" name="Try again?" default="Flow_1mzvgze">
      <bpmn:incoming>Flow_1h3pian</bpmn:incoming>
      <bpmn:outgoing>Flow_1mzvgze</bpmn:outgoing>
      <bpmn:outgoing>Flow_07n6k85</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_1h3pian" sourceRef="Activity_1b34ye9" targetRef="Gateway_0msy8h1" />
    <bpmn:endEvent id="Event_0aroag0" name="Not paid: customer stopped">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="=&#34;UNPAID&#34;" target="orderStatus" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1mzvgze</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1mzvgze" name="No" sourceRef="Gateway_0msy8h1" targetRef="Event_0aroag0" />
    <bpmn:sequenceFlow id="Flow_0b86b76" name="Approved" sourceRef="Gateway_0fve4zz" targetRef="Activity_1wworen">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=paymentStatus = "APPROVED"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:serviceTask id="Activity_1wworen" name="Update inventory">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="update-inventory" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0b86b76</bpmn:incoming>
      <bpmn:outgoing>Flow_0r6yfq1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:scriptTask id="Activity_1di40os" name="Calculate commission">
      <bpmn:extensionElements>
        <zeebe:script expression="=for part in producerParts return {&#10;  producerId: part.producerId,&#10;  grossPence: part.subtotalPence,&#10;  commissionPence: round half up(part.subtotalPence * 0.05, 0),&#10;  netPence: part.subtotalPence - round half up(part.subtotalPence * 0.05, 0)&#10;}" resultVariable="producerShares" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0r6yfq1</bpmn:incoming>
      <bpmn:outgoing>Flow_0qktwlm</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="Flow_0r6yfq1" sourceRef="Activity_1wworen" targetRef="Activity_1di40os" />
    <bpmn:serviceTask id="Activity_1b979ic" name="Notify producer">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="notify-producer" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0qktwlm</bpmn:incoming>
      <bpmn:outgoing>Flow_1ln63xc</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics>
        <bpmn:extensionElements>
          <zeebe:loopCharacteristics inputCollection="=producerParts" inputElement="producerPart" />
        </bpmn:extensionElements>
      </bpmn:multiInstanceLoopCharacteristics>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_0qktwlm" sourceRef="Activity_1di40os" targetRef="Activity_1b979ic" />
    <bpmn:endEvent id="Event_0n0zfbw" name="Order paid">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="=&#34;CONFIRMED&#34;" target="orderStatus" />
          <zeebe:output source="=sum(producerShares.commissionPence)" target="commissionTotalPence" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1ln63xc</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1ln63xc" sourceRef="Activity_1b979ic" targetRef="Event_0n0zfbw" />
    <bpmn:boundaryEvent id="Event_05smdbd" name="Payment service unavailable" attachedToRef="Activity_0xalhrl">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="=null" target="testCardNumber" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_1umldow</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_1hnxics" errorRef="Error_1egj00q" />
    </bpmn:boundaryEvent>
    <bpmn:startEvent id="StartEvent_1" name="Payment requested">
      <bpmn:outgoing>Flow_073u1e3</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Gateway_1oqi2gn">
      <bpmn:incoming>Flow_073u1e3</bpmn:incoming>
      <bpmn:incoming>Flow_07n6k85</bpmn:incoming>
      <bpmn:outgoing>Flow_1yqvjqy</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_073u1e3" sourceRef="StartEvent_1" targetRef="Gateway_1oqi2gn" />
    <bpmn:sequenceFlow id="Flow_1yqvjqy" sourceRef="Gateway_1oqi2gn" targetRef="Activity_1muf6gd" />
    <bpmn:sequenceFlow id="Flow_07n6k85" name="Yes" sourceRef="Gateway_0msy8h1" targetRef="Gateway_1oqi2gn">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=retryPayment = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:exclusiveGateway id="Gateway_1rq6wws">
      <bpmn:incoming>Flow_01228dd</bpmn:incoming>
      <bpmn:incoming>Flow_0h0s9zh</bpmn:incoming>
      <bpmn:outgoing>Flow_12jj8o5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_01228dd" sourceRef="Activity_1muf6gd" targetRef="Gateway_1rq6wws" />
    <bpmn:sequenceFlow id="Flow_0h0s9zh" sourceRef="Event_0safgti" targetRef="Gateway_1rq6wws" />
    <bpmn:sequenceFlow id="Flow_12jj8o5" sourceRef="Gateway_1rq6wws" targetRef="Activity_05limqu" />
    <bpmn:scriptTask id="Activity_05limqu" name="Count payment attempt">
      <bpmn:extensionElements>
        <zeebe:script expression="=if paymentAttempts = null then 1 else paymentAttempts + 1" resultVariable="paymentAttempts" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_12jj8o5</bpmn:incoming>
      <bpmn:outgoing>Flow_16onj4i</bpmn:outgoing>
    </bpmn:scriptTask>
  </bpmn:process>
