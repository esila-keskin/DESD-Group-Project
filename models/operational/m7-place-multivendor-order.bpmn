        <bpmn:flowNodeRef>Gateway_0pzgw2d</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_1g1yqnp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_0v67wam</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_0d905fq" name="Customer">
        <bpmn:flowNodeRef>Activity_1y0mbbh</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_1dzz5rv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_03q8l8l</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_0stcl0p</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_17koz3k</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_0mffy6a</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:serviceTask id="Activity_1o5tk8a" name="Check stock">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="check-stock" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1q0zp5u</bpmn:incoming>
      <bpmn:outgoing>Flow_12vwq71</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_1c9lh01" name="Enough stock?" default="Flow_0ylglla">
      <bpmn:incoming>Flow_12vwq71</bpmn:incoming>
      <bpmn:outgoing>Flow_0ylglla</bpmn:outgoing>
      <bpmn:outgoing>Flow_0ww3pby</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Activity_1y0mbbh" name="Amend quantities">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="f1-amend-order" />
        <zeebe:ioMapping>
          <zeebe:input source="=basketItems" target="originalItems" />
          <zeebe:output source="=(for i in 1..count(originalItems) return context put(originalItems[i], &#34;quantity&#34;, basketItems[i].quantity))[item.quantity &#62; 0]" target="basketItems" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0ylglla</bpmn:incoming>
      <bpmn:outgoing>Flow_0zxadwa</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:scriptTask id="Activity_0adeec0" name="Split order by producer and work out total">
      <bpmn:extensionElements>
        <zeebe:script expression="=for pid in distinct values(basketItems.producerId) return {&#10;  producerId: pid,&#10;  producerName: (basketItems[item.producerId = pid])[1].producerName,&#10;  fulfilmentMethod: &#34;delivery&#34;,&#10;  earliestDate: string(today() + duration(&#34;P2D&#34;)),&#10;  subtotalPence: sum(for i in basketItems[item.producerId = pid] return i.quantity * i.unitPricePence)&#10;}" resultVariable="producerParts" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0ww3pby</bpmn:incoming>
      <bpmn:outgoing>Flow_00if9ie</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:userTask id="Activity_1dzz5rv" name="Choose delivery or collection and confirm order">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="f1-confirm-order" />
        <zeebe:ioMapping>
          <zeebe:input source="=producerParts" target="splitParts" />
          <zeebe:input source="=sum(producerParts.subtotalPence)" target="orderTotalPence" />
          <zeebe:output source="=for i in 1..count(splitParts) return context put(splitParts[i], &#34;fulfilmentMethod&#34;, producerParts[i].fulfilmentMethod)" target="producerParts" />
          <zeebe:output source="=orderTotalPence" target="orderTotalPence" />
          <zeebe:output source="=orderConfirmed" target="orderConfirmed" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_00if9ie</bpmn:incoming>
      <bpmn:outgoing>Flow_10o22ff</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="Event_03q8l8l" name="Order abandoned">
      <bpmn:incoming>Flow_0hu2qdh</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_05vttvi" name="Order confirmed?" default="Flow_0x1edo8">
      <bpmn:incoming>Flow_10o22ff</bpmn:incoming>
      <bpmn:outgoing>Flow_0x1edo8</bpmn:outgoing>
      <bpmn:outgoing>Flow_0zn7pe7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Event_0yh4ivp" name="Order cancelled by customer">
      <bpmn:incoming>Flow_0x1edo8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:callActivity id="Activity_0dz05sb" name="Process payment and commission">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="process-payment-commission" propagateAllChildVariables="false" propagateAllParentVariables="false" />
        <zeebe:ioMapping>
          <zeebe:input source="=orderId" target="orderId" />
          <zeebe:input source="=customerName" target="customerName" />
          <zeebe:input source="=customerEmail" target="customerEmail" />
          <zeebe:input source="=basketItems" target="basketItems" />
          <zeebe:input source="=producerParts" target="producerParts" />
          <zeebe:input source="=orderTotalPence" target="orderTotalPence" />
          <zeebe:output source="=paymentStatus" target="paymentStatus" />
          <zeebe:output source="=paymentAttempts" target="paymentAttempts" />
          <zeebe:output source="=producerShares" target="producerShares" />
          <zeebe:output source="=commissionTotalPence" target="commissionTotalPence" />
          <zeebe:output source="=orderStatus" target="orderStatus" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0zn7pe7</bpmn:incoming>
      <bpmn:outgoing>Flow_134c5e9</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="Gateway_0pzgw2d" name="Payment approved?" default="Flow_1tnf0na">
      <bpmn:incoming>Flow_134c5e9</bpmn:incoming>
      <bpmn:outgoing>Flow_0ljre5m</bpmn:outgoing>
      <bpmn:outgoing>Flow_1tnf0na</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Event_1g1yqnp" name="Order placed">
      <bpmn:incoming>Flow_0ljre5m</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="Event_0v67wam" name="Order not placed (unpaid)">
      <bpmn:incoming>Flow_1tnf0na</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="StartEvent_1" name="Basket submitted at checkout">
      <bpmn:outgoing>Flow_1kvican</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Activity_0stcl0p" name="Review basket and enter details">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="f1-review-basket" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1kvican</bpmn:incoming>
      <bpmn:outgoing>Flow_1xnpk9v</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_17koz3k">
      <bpmn:incoming>Flow_1xnpk9v</bpmn:incoming>
      <bpmn:incoming>Flow_0zxadwa</bpmn:incoming>
      <bpmn:outgoing>Flow_1q0zp5u</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:boundaryEvent id="Event_0mffy6a" name="30 minutes" attachedToRef="Activity_1dzz5rv">
      <bpmn:outgoing>Flow_0hu2qdh</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_0xgcf2h">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT30M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_1q0zp5u" sourceRef="Gateway_17koz3k" targetRef="Activity_1o5tk8a" />
    <bpmn:sequenceFlow id="Flow_12vwq71" sourceRef="Activity_1o5tk8a" targetRef="Gateway_1c9lh01" />
    <bpmn:sequenceFlow id="Flow_0ylglla" name="No" sourceRef="Gateway_1c9lh01" targetRef="Activity_1y0mbbh" />
    <bpmn:sequenceFlow id="Flow_0ww3pby" name="Yes" sourceRef="Gateway_1c9lh01" targetRef="Activity_0adeec0">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=stockOk = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0zxadwa" sourceRef="Activity_1y0mbbh" targetRef="Gateway_17koz3k" />
