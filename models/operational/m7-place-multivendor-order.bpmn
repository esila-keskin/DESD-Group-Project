    <bpmn:sequenceFlow id="Flow_0x1edo8" name="No" sourceRef="Gateway_05vttvi" targetRef="Event_0yh4ivp" />
    <bpmn:sequenceFlow id="Flow_0zn7pe7" name="Yes" sourceRef="Gateway_05vttvi" targetRef="Activity_0dz05sb">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=orderConfirmed = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_134c5e9" sourceRef="Activity_0dz05sb" targetRef="Gateway_0pzgw2d" />
    <bpmn:sequenceFlow id="Flow_0ljre5m" name="Yes" sourceRef="Gateway_0pzgw2d" targetRef="Event_1g1yqnp">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=orderStatus = "CONFIRMED"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1tnf0na" name="No" sourceRef="Gateway_0pzgw2d" targetRef="Event_0v67wam" />
    <bpmn:sequenceFlow id="Flow_1kvican" sourceRef="StartEvent_1" targetRef="Activity_0stcl0p" />
    <bpmn:sequenceFlow id="Flow_1xnpk9v" sourceRef="Activity_0stcl0p" targetRef="Gateway_17koz3k" />
  </bpmn:process>
