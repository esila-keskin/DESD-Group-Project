<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Web Modeler" exporterVersion="f127538" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.10.0">
  <bpmn:collaboration id="Collaboration_19fqfyk" name="Sprint 1 strategic model - Bristol Regional Food Network - Group 51.">
    <bpmn:participant id="Participant_0djqv3n" name="Bristol Regional Food Network: Marketplace Platform" processRef="Process_0ccldlc">
      <bpmn:documentation>Case study: "The marketplace platform must provide…". Lanes group the platform's organisational functions: Quality &amp; Traceability, Catalogue &amp; Listings, Order Management, Payments &amp; Settlement, Community &amp; Sustainability.</bpmn:documentation>
    </bpmn:participant>
    <bpmn:participant id="Participant_1kmdp14" name="Customers" processRef="Process_0r9cpgl">
      <bpmn:documentation>Three segments with stated barriers: young professionals and families (restricted farm-shop opening hours); community groups (finding reliable local suppliers); independent restaurants and cafés (admin overhead of multiple suppliers).</bpmn:documentation>
    </bpmn:participant>
    <bpmn:participant id="Participant_1t9zsx8" name="Certification Service (external)" processRef="Process_1qw2d1s">
      <bpmn:documentation>External. Organic certification status is a stated product attribute; Use Case 1 refers to an "external or simulated verification service".</bpmn:documentation>
    </bpmn:participant>
    <bpmn:participant id="Participant_0eqhu7r" name="Producers" processRef="Process_0lugs2t">
      <bpmn:documentation>"forty small-to-medium enterprises"; "technical capabilities amongst producers vary considerably"; some spend "approximately fifteen hours per week" on customer communication.</bpmn:documentation>
    </bpmn:participant>
    <bpmn:participant id="Participant_1f68kc9" name="Payment Provider" processRef="Process_031e8p6">
      <bpmn:documentation>External. The case study requires test environments only: "Under no circumstances should live payment systems or real financial data be used".</bpmn:documentation>
    </bpmn:participant>
